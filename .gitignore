# Godot 4+ specific ignores
.godot/
/android/
.import/
export_preserts.cfg
.tmp

# GodotSteam extension download/extraction leftovers (Windows temp files)
addons/godotsteam/**/~*
*.TMP

# Traductions compilées par Godot depuis translations/game.csv : régénérées
# à l'import, leur sérialisation binaire change à chaque recompilation même
# sans changement de contenu (diffs fantômes, conflits binaires non fusionnables)
translations/*.translation