# Godot 4+ specific ignores
.godot/
/android/
.import/
export_preserts.cfg
.tmp

# Build de sortie (export Windows), local uniquement — a copier ensuite dans
# sdk/tools/ContentBuilder/content/ pour la publication Steam
/build/

# GodotSteam extension download/extraction leftovers (Windows temp files)
addons/godotsteam/**/~*
*.TMP

# Traductions compilées par Godot depuis translations/game.csv : régénérées
# à l'import, leur sérialisation binaire change à chaque recompilation même
# sans changement de contenu (diffs fantômes, conflits binaires non fusionnables)
translations/*.translation
.devlog/

# Brouillons/archives de devlog hebdomadaire : notes de session brutes,
# usage interne uniquement — ne doit pas apparaître sur GitHub.
/devlogs/