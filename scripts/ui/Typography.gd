class_name Typography
## Échelle typographique unique du jeu : 5 tailles seulement.
## Toute nouvelle taille de police doit utiliser une de ces constantes plutôt qu'une valeur en dur.

const MICRO := 12   # Tooltips, badges, coûts réduits, texte secondaire minuscule
const BODY := 16    # Corps de texte, labels standards, boutons courants
const SECTION := 20 # Titres de section, boutons importants
const HEADER := 28  # Titres d'écran, headers majeurs
const HERO := 40    # Très gros titres (écrans de fin, bannières)
