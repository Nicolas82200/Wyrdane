class_name Typography
## Échelle typographique unique du jeu : 5 tailles seulement.
## Toute nouvelle taille de police doit utiliser une de ces constantes plutôt qu'une valeur en dur.

const MICRO := 15   # Tooltips, badges, coûts réduits, texte secondaire minuscule
const BODY := 19    # Corps de texte, labels standards, boutons courants
const SECTION := 23 # Titres de section, boutons importants
const HEADER := 29  # Titres d'écran, headers majeurs — volontairement pas augmenté (demande utilisateur du 2026-09-25 : les titres de panneaux restent tels quels)
const HERO := 41    # Très gros titres (écrans de fin, bannières)
