; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wyrdane"
config/description="Wyrdane is a fantasy trading card game set in a world where ancient civilizations, powerful factions, and forgotten magic collide. Players build decks around unique races and strategic mechanics, commanding heroes, creatures, and spells in tactical battles. The project emphasizes rich world-building, meaningful gameplay, and a distinctive visual identity inspired by dark and high fantasy."
run/main_scene="uid://byp8qcya3aete"
config/quit_on_go_back=false
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://assets/splash/boot_splash.png"
config/icon="uid://bg63blxvj7mod"
run/autoload_on_startup=false

[autoload]

AudioManager="*uid://crtkgkw4huv2w"
DeckManager="*uid://3685wo5revnf"
TooltipData="*uid://bxsh8pr326i0h"
CardLibrary="*uid://d3txnel4suoji"
SettingsManager="*res://scripts/settings/SettingsManager.gd"
CollectionManager="*res://scripts/collection/CollectionManager.gd"
BackendClient="*res://scripts/net/BackendClient.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

end_turn={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
toggle_graveyard={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":71,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
toggle_enemy_graveyard={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":72,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://translations/game.fr.translation", "res://translations/game.en.translation")

[physics]

3d/physics_engine="Jolt Physics"

[steam]

initialization/app_data/app_type=0
initialization/app_data/app_id=0
initialization/app_data/demo_id=0
initialization/app_data/playtest_id=0
initialization/app_data/tool_id=0
initialization/processes/initialize_on_startup=false
initialization/processes/embed_callbacks=false
multiplayer_peer/max_channels=4
